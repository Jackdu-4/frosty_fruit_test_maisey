<div>
  <div class="grid">
    <div class="grid__item" style="margin-top: 0px;">
      {% comment %} <div class="section-header text-center">
        {% assign exclusivePageHandles =  settings.page_handle_exclusions | split: ',' %}
        {% unless exclusivePageHandles contains page.handle %}
        <h1>{{ page.title }}</h1>
         {% endunless %}
      </div> {% endcomment %}

      <div class="rte">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>
